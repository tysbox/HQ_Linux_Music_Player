[Unit]
Description=HQ Linux Music Player — Audiophile New GUI (Port 3003)
After=network.target hq-api.service
Wants=hq-api.service
Requires=hq-api.service

[Service]
Type=simple
User=tysbox
Group=tysbox
WorkingDirectory=/home/tysbox/HQ_Linux_Music_Player/new-gui
Environment=NODE_ENV=production
Environment=PORT=3003
Environment=HOSTNAME=0.0.0.0
Environment=PATH=/home/tysbox/.local/nodejs/node/bin:/usr/bin:/bin
ExecStartPre=/bin/bash -c 'mkdir -p .next/standalone/.next && rm -rf .next/standalone/.next/static && cp -r .next/static .next/standalone/.next/ && rm -rf .next/standalone/public && cp -r public .next/standalone/'
ExecStart=/home/tysbox/.local/nodejs/node/bin/node /home/tysbox/HQ_Linux_Music_Player/new-gui/.next/standalone/server.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=audiophile-new-gui

[Install]
WantedBy=multi-user.target