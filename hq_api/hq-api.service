[Unit]
Description=HQ Linux Music Player — Unified API (Phase 3b, port 8002)
After=network.target mpd.service
Wants=mpd.service
Requires=mpd.service
# 旧 DSP/DMP サービスとの同時起動を防止（CamillaDSP/ALSA 設定競合回避）
Conflicts=audiophile-backend.service audiophile-frontend.service hq-dmp-backend.service hq-dmp-frontend.service

[Service]
Type=simple
User=tysbox
Group=tysbox
WorkingDirectory=/home/tysbox/HQ_Linux_Music_Player
# 旧 DSP/DMP と同じ PYTHONPATH（dmp/backend も解決するため）
Environment="PYTHONPATH=/home/tysbox/HQ_Linux_Music_Player:/home/tysbox/HQ_Linux_Music_Player/dmp/backend"
Environment="HQ_API_PORT=8002"
ExecStart=/home/tysbox/HQ_Linux_Music_Player/backend/venv/bin/python3 -m uvicorn hq_api.main:app --host 0.0.0.0 --port 8002 --log-level info
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hq-api

[Install]
WantedBy=multi-user.target
