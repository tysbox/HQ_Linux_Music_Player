# HQ Linux Music Player — 移植先ごとの環境上書き設定 (任意)
#
# 配置先: /etc/hqmplayer/hqmplayer.env
#   sudo mkdir -p /etc/hqmplayer
#   sudo cp config/systemd/hqmplayer.env.example /etc/hqmplayer/hqmplayer.env
#   sudo editor /etc/hqmplayer/hqmplayer.env   # 移植先の値へ編集
#
# systemd unit 側で `EnvironmentFile=-/etc/hqmplayer/hqmplayer.env` として読み込む。
# 未設定でも unit 内の既定値で動作する (すべて省略可能)。
#
# 例 (192.168.0.50 の端末へ移植する場合):
# MPD_HOST=127.0.0.1
# MPD_PORT=6600
# CAMILLA_HOST=127.0.0.1
# CAMILLA_PORT=1234
# AUDIOPHILE_CONFIG_DIR=/home/hqm/.config/audiophile
# HQ_DMP_BACKEND=/opt/hqmplayer/dmp/backend
# ALLOWED_ORIGINS=http://192.168.0.50:3003
# HQ_GUI_ORIGINS=http://192.168.0.50:3002
# HQ_UPNP_SERVERS_FILE=/etc/hqmplayer/upnp_servers.json
# HQ_UPNP_REACH_TTL=30
# HQ_ALSA_CACHE_TTL=60
# HQ_HEALTH_DSP_TIMEOUT=0.5
# CAMILLA_VOLUME_RETRIES=40
# CAMILLA_VOLUME_INTERVAL=0.05
# HQ_DSP_YAML=/tmp/camilladsp/active_dsp.yml
# CAMILLA_STATE_FILE=/tmp/camilladsp/state.yml
