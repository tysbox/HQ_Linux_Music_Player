[Unit]
Description=HQ Linux Music Player — DMP Backend
After=network.target mpd.service
Wants=mpd.service
Requires=mpd.service
# 統合 API (hq-api) との同時起動を防止（CamillaDSP/ALSA 設定競合回避）
Conflicts=hq-api.service unified-shell.service

[Service]
Type=simple
User=tysbox
Group=tysbox
WorkingDirectory=/home/tysbox/HQ_Linux_Music_Player/dmp/backend
Environment="PYTHONPATH=/home/tysbox/HQ_Linux_Music_Player:/home/tysbox/HQ_Linux_Music_Player/dmp/backend"
ExecStart=/home/tysbox/HQ_Linux_Music_Player/dmp/backend/venv/bin/python3 -m uvicorn \
    app.main:app \
    --host 0.0.0.0 \
    --port 8001 \
    --log-level info
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hq-dmp-backend

[Install]
WantedBy=multi-user.target
